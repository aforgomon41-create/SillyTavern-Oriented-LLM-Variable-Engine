{
  "name": "solve-variable-engine",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "SillyTavern 1.19 structured variable engine",
  "exports": { ".": "./src/index.ts", "./sillytavern": "./src/host/controller.ts", "./adapter": "./src/host/sillytavern.ts" },
  "scripts": {
    "test": "tsx --test --test-reporter=spec tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "test:host": "tsx scripts/test-host.ts",
    "test:bundle": "node scripts/test-bundle.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run test:bundle"
  },
  "dependencies": {
    "@toon-format/toon": "4.4.0",
    "fast-json-patch": "3.1.1",
    "jsonrepair": "3.13.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "esbuild": "^0.25.12",
    "fake-indexeddb": "^6.2.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
